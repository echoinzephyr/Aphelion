menu "Aphelion hardware"

    config APHELION_TOOLBOX
        bool "Build the headless toolbox firmware"
        default n

    choice APHELION_OLED_MODEL
        prompt "I2C OLED controller and size"
        depends on !APHELION_TOOLBOX
        default APHELION_OLED_SSD1306_64

        config APHELION_OLED_SSD1306_64
            bool "SSD1306 128x64"

        config APHELION_OLED_SSD1306_32
            bool "SSD1306 128x32"

        config APHELION_OLED_SH1106
            bool "SH1106 128x64"
    endchoice

endmenu
